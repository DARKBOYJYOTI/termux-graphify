+# ── CLI-agent backends: hermes / opencode / codex (headless, free tier) ───────
+# These mirror the claude-cli pattern: shell out to a locally-installed coding
+# agent CLI in one-shot headless mode and parse its stdout for the JSON
+# fragment. No API key needed — auth comes from each CLI's own config.
+# Priority (all free tiers):
+#   hermes   -> `hermes -z "<prompt>"`  (uses Hermes' configured free model)
+#   opencode -> `opencode run "<prompt>" --format json` (opencode-go/deepseek-v4-flash)
+#   codex    -> `codex exec "<prompt>"` (codex-mini; needs a git repo cwd)
+
+
+def _cli_extraction_message(user_message: str, *, deep_mode: bool = False) -> str:
+    """Build the combined system+user message for the CLI-agent backends.
+
+    Same delivery-channel lesson as claude-cli (#2076): put the full schema and
+    an explicit imperative in the USER turn (the CLIs are coding agents and
+    would otherwise answer conversationally about the file dump instead of
+    emitting the JSON object).
+    """
+    return (
+        _extraction_system(deep=deep_mode)
+        + "\n\n---\n"
+        + "Now extract the knowledge graph from the following source file(s) "
+        + "and output ONLY the JSON object described above. No prose, no "
+        + "preamble, no markdown fences.\n\n"
+        + user_message
+    )
+
+
+def _cli_result_from_text(raw_content: str, *, model: str) -> dict:
+    """Turn a CLI's plain-text stdout into a graphify result dict.
+
+    Used by hermes/codex, which print the model's answer as plain text.
+    """
+    result = _parse_llm_json(raw_content or "{}")
+    result["input_tokens"] = 0
+    result["output_tokens"] = 0
+    result["model"] = model
+    result["finish_reason"] = "stop"
+    if _response_is_hollow(raw_content, result) and result["finish_reason"] != "length":
+        print(
+            "[graphify] CLI backend returned a hollow response; treating as "
+            "truncation so adaptive retry can bisect the chunk.",
+            file=sys.stderr,
+        )
+        result["finish_reason"] = "length"
+    return result
+
+
+def _opencode_parse_events(stdout: str) -> tuple[str, int, int]:
+    """Extract text + token usage from `opencode run --format json` NDJSON.
+
+    opencode emits one JSON object per line: step_start / text / step_finish /
+    reasoning events. We collect the text of every ``{"type":"text"}`` event
+    (the model's actual answer; reasoning events are separate) and the
+    input/output token counts from the final step_finish event.
+    """
+    texts: list[str] = []
+    inp = out = 0
+    for line in stdout.splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            ev = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        if not isinstance(ev, dict):
+            continue
+        if ev.get("type") == "text":
+            part = ev.get("part") or {}
+            if isinstance(part, dict):
+                txt = part.get("text")
+                if isinstance(txt, str):
+                    texts.append(txt)
+        elif ev.get("type") == "step_finish":
+            part = ev.get("part") or {}
+            tokens = part.get("tokens") if isinstance(part, dict) else None
+            if isinstance(tokens, dict):
+                inp = int(tokens.get("input", 0) or 0)
+                out = int(tokens.get("output", 0) or 0)
+    return "\n".join(texts).strip(), inp, out
+
+
+def _call_hermes_cli(user_message: str, max_tokens: int = 8192, *, deep_mode: bool = False, images: list[_ImageRef] | None = None) -> dict:
+    """Call Hermes Agent CLI in one-shot headless mode (`hermes -z`).
+
+    Uses the user's existing Hermes provider config — the default model is
+    typically the free opencode-go/deepseek-v4-flash tier, so no API key and
+    no cost. GRAPHIFY_HERMES_CLI_MODEL overrides the model.
+    """
+    import shutil
+    import subprocess
+
+    if shutil.which("hermes") is None:
+        raise RuntimeError("hermes CLI not found on $PATH. Install Hermes Agent (hermes setup).")
+    combined = _cli_extraction_message(user_message, deep_mode=deep_mode)
+    cli_args = ["hermes", "-z", combined]
+    cli_model = os.environ.get("GRAPHIFY_HERMES_CLI_MODEL", "").strip()
+    if cli_model:
+        cli_args.extend(["-m", cli_model])
+    proc = subprocess.run(
+        cli_args,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        errors="replace",
+        timeout=_resolve_api_timeout(),
+        check=False,
+        **_no_window_kwargs(),
+    )
+    if proc.returncode != 0:
+        detail = proc.stderr.strip() or proc.stdout.strip() or "(no output)"
+        raise RuntimeError(f"hermes -z exited {proc.returncode}: {detail[:500]}")
+    return _cli_result_from_text(proc.stdout, model=cli_model or "hermes-default")
+
+
+def _call_opencode_cli(user_message: str, max_tokens: int = 8192, *, deep_mode: bool = False, images: list[_ImageRef] | None = None) -> dict:
+    """Call OpenCode CLI in headless mode (`opencode run --format json`).
+
+    Default model is the free opencode-go/deepseek-v4-flash tier; OPENCODE_MODEL
+    or GRAPHIFY_OPENCODE_CLI_MODEL overrides it. `--pure` skips external plugins
+    so the run is deterministic.
+    """
+    import shutil
+    import subprocess
+
+    if shutil.which("opencode") is None:
+        raise RuntimeError("opencode CLI not found on $PATH. Install OpenCode (opencode auth login).")
+    combined = _cli_extraction_message(user_message, deep_mode=deep_mode)
+    cli_model = (
+        os.environ.get("GRAPHIFY_OPENCODE_CLI_MODEL", "").strip()
+        or os.environ.get("OPENCODE_MODEL", "").strip()
+        or "opencode-go/deepseek-v4-flash"
+    )
+    cli_args = ["opencode", "run", "--pure", "--format", "json", "--model", cli_model, combined]
+    proc = subprocess.run(
+        cli_args,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        errors="replace",
+        timeout=_resolve_api_timeout(),
+        check=False,
+        **_no_window_kwargs(),
+    )
+    if proc.returncode != 0:
+        detail = proc.stderr.strip() or proc.stdout.strip() or "(no output)"
+        raise RuntimeError(f"opencode run exited {proc.returncode}: {detail[:500]}")
+    raw_content, inp, out = _opencode_parse_events(proc.stdout)
+    result = _parse_llm_json(raw_content or "{}")
+    result["input_tokens"] = inp
+    result["output_tokens"] = out
+    result["model"] = cli_model
+    result["finish_reason"] = "stop"
+    if _response_is_hollow(raw_content, result):
+        print(
+            "[graphify] opencode returned a hollow response; treating as "
+            "truncation so adaptive retry can bisect the chunk.",
+            file=sys.stderr,
+        )
+        result["finish_reason"] = "length"
+    return result
+
+
+def _call_codex_cli(user_message: str, max_tokens: int = 8192, *, deep_mode: bool = False, images: list[_ImageRef] | None = None) -> dict:
+    """Call OpenAI Codex CLI in headless mode (`codex exec`).
+
+    Default model is the free codex-mini tier; CODEX_MODEL or
+    GRAPHIFY_CODEX_CLI_MODEL overrides it. Codex refuses to run outside a git
+    repo, so when the CWD is not one we init a throwaway repo in a temp dir and
+    run there (the prompt carries all file content inline, so cwd does not
+    matter for the model).
+    """
+    import shutil
+    import subprocess
+    import tempfile
+
+    if shutil.which("codex") is None:
+        raise RuntimeError("codex CLI not found on $PATH. Install Codex (npm i -g @openai/codex).")
+    combined = _cli_extraction_message(user_message, deep_mode=deep_mode)
+    cli_model = (
+        os.environ.get("GRAPHIFY_CODEX_CLI_MODEL", "").strip()
+        or os.environ.get("CODEX_MODEL", "").strip()
+    )
+    cli_args = ["codex", "exec", "--sandbox", "danger-full-access"]
+    if cli_model:
+        cli_args.extend(["-m", cli_model])
+    cli_args.append(combined)
+    # Codex requires a git repo; if the CWD is not one, run from a temp repo.
+    cwd = None
+    import subprocess as _sp
+    git_ok = _sp.run(["git", "rev-parse", "--is-inside-work-tree"], capture_output=True, text=True).returncode == 0
+    if not git_ok:
+        tmp = tempfile.mkdtemp(prefix="graphify-codex-")
+        _sp.run(["git", "init", "-q"], cwd=tmp, capture_output=True)
+        cwd = tmp
+    try:
+        proc = subprocess.run(
+            cli_args,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+            timeout=_resolve_api_timeout(),
+            check=False,
+            cwd=cwd,
+            **_no_window_kwargs(),
+        )
+    finally:
+        if cwd is not None:
+            import shutil as _sh
+            _sh.rmtree(cwd, ignore_errors=True)
+    if proc.returncode != 0:
+        detail = proc.stderr.strip() or proc.stdout.strip() or "(no output)"
+        raise RuntimeError(f"codex exec exited {proc.returncode}: {detail[:500]}")
+    return _cli_result_from_text(proc.stdout, model=cli_model)
+
